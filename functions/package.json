{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "export-prod": "npm run build && node lib/export-prod-data.js",
    "dev": "npm run build && firebase emulators:start --inspect-functions --only functions",
    "emulator": "npm run build && firebase emulators:start --import=../.emulator-data --export-on-exit=../.emulator-data",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed-story": "node scripts/create-story-by-admin.js",
    "seed-competitions": "node scripts/seed-competitions.js",
    "set-admin": "node scripts/set-admin-claim.js",
    "unset-admin": "node scripts/set-admin-claim.js --revoke",
    "mcp-requests": "node scripts/list-mcp-requests.js",
    "grant-mcp": "node scripts/set-mcp-access.js",
    "revoke-mcp": "node scripts/set-mcp-access.js --revoke"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^9.0.3",
    "replicate": "^1.4.0",
    "typescript": "^5.7.3",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0"
  },
  "private": true,
  "overrides": {
    "protobufjs": "^7.5.5",
    "fast-xml-parser": "^5.0.0",
    "websocket-driver": "^0.7.5",
    "uuid": "^11.1.1"
  }
}
