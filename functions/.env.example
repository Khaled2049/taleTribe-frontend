# Assistant rollout flags. Set in Functions configuration, never as VITE_ values.
ASSISTANT_API_ENABLED=true
ASSISTANT_EDIT_PROPOSALS_ENABLED=true
ASSISTANT_RESEARCH_ENABLED=false
# Starts the local assistant run gateway on :5002 (dev-new.sh reads this).
# Not a deployed setting: ignored outside the Firebase emulator.
ASSISTANT_GATEWAY_ENABLED=true
