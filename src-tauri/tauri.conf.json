{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TheTaleTribe",
  "version": "0.1.0",
  "identifier": "com.thetaletribe.reader",
  "build": {
    "frontendDist": "../dist-mobile",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run mobile:dev",
    "beforeBuildCommand": "npm run mobile:build"
  },
  "app": {
    "windows": [
      {
        "title": "TheTaleTribe",
        "url": "mobile.html",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
