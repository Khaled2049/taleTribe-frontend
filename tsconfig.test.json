{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "tests",
    "src/types/IPlot.ts",
    "src/routes/Auth/mcpConsentScopes.ts",
    "src/utils/epubExport.ts",
    "src/types/IStory.ts",
    "src/lib/money.ts",
    "src/types/IToken.ts",
    "src/lib/competitionPhase.ts",
    "src/lib/competitionListing.ts",
    "src/lib/pagination.ts",
    "src/types/ICompetition.ts",
    // Settlement arithmetic is NOT duplicated into src/lib the way money.ts and
    // competitionPhase.ts are — a divergence would change who gets paid — so the
    // test reaches into functions/. Safe because the module has zero imports.
    "functions/src/competitionSettlementCore.ts"
  ]
}
