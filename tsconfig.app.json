{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@novelsync/story-data-client": [
        "./packages/story-data-client/src/index.ts"
      ],
      "@novelsync/platform-auth/firestore": ["./src/platform/firestore.ts"],
      "@novelsync/platform-auth/storage": ["./src/platform/storage.ts"],
      "@novelsync/platform-auth": ["./src/platform/auth.ts"],
      "@novelsync/platform-auth/core": [
        "./packages/platform-auth/src/index.ts"
      ],
      "@novelsync/platform-auth/firestore-core": [
        "./packages/platform-auth/src/firestore.ts"
      ],
      "@novelsync/platform-auth/storage-core": [
        "./packages/platform-auth/src/storage.ts"
      ],
      "@novelsync/reader-ui": ["./packages/reader-ui/src/index.ts"],
      "@novelsync/reader-ui/*": ["./packages/reader-ui/src/*"],
      "@novelsync/assistant-contracts": [
        "./packages/assistant-contracts/src/index.ts"
      ]
    }
  },
  "include": ["src", "packages/*/src"]
}
