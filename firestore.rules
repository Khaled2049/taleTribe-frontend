rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Firestore is default-deny: a path with no matching rule is refused, so
    // this file only needs blocks for what a browser actually touches. After
    // the PostgreSQL cutover that is a short list — stories, chapters,
    // worldbuilding, social, guestbooks, profiles, book club records and
    // competitions are all served by story-data over HTTP, where authorization
    // lives in Go rather than here.
    //
    // What remains in Firestore, and why:
    //   invites       — signup gate, needs unauthenticated reads
    //   users         — BYOK settings and the AI usage counters
    //   userActivity  — client-side rate limits for the two features below
    //   stories/chats — AI chat transcripts, kept for realtime
    //   bookClubs     — club chat, kept for realtime
    //   mcpAccess     — MCP allowlist requests
    //   mcpOauth*     — MCP server state, Admin SDK only

    // Invites collection for invite-only signup
    match /invites/{email} {
      // enforce linkSentCount == 0 on create — prevent injecting a pre-incremented counter.
      allow create: if request.auth == null
                    && request.resource.data.email == email
                    && request.resource.data.status == "pending"
                    && request.resource.data.linkSentCount == 0
                    && request.resource.data.keys().hasAll(["email", "status", "requestedAt", "linkSentCount"]);

      // Unauthenticated get is intentional — allows invite status check before login.
      // list=false prevents email enumeration via collection scans.
      allow get: if request.auth == null ||
                   (request.auth != null && request.auth.token.email == email);
      allow list: if false;

      // scope update to status field only — other fields immutable after create.
      allow update: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email == email
                    && request.resource.data.status == "completed"
                    && (resource.data.status == "sent" || resource.data.status == "approved")
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);

      allow delete: if false;
    }

    // The story document itself lives in PostgreSQL. This block exists only as
    // the parent path for chat sessions, which stayed in Firestore for their
    // realtime listener — hence no rules on the story document.
    match /stories/{storyId} {

      // Chat sessions are the last Firestore-resident part of a story, and the
      // story document itself no longer exists here — it is in PostgreSQL. A
      // get() on a missing doc returns null and dereferencing .data denies, so
      // ownership is a field compare against the session's own denormalized
      // uid.
      //
      // The client lists these with a userId filter; a resource-based read rule
      // denies any query that could return someone else's session.
      match /chats/{chatId} {
        allow read: if request.auth != null &&
          resource.data.userId == request.auth.uid;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          resource.data.userId == request.auth.uid;

        // Messages carry no owner of their own and are written only by Cloud
        // Functions, so they inherit the session's. exists() first: an
        // unguarded get() on a missing parent errors, which denies.
        match /messages/{messageId} {
          allow read: if request.auth != null &&
            exists(/databases/$(database)/documents/stories/$(storyId)/chats/$(chatId)) &&
            get(/databases/$(database)/documents/stories/$(storyId)/chats/$(chatId)).data.userId == request.auth.uid;
          allow write: if false;
        }
      }
    }

    match /bookClubs/{clubId} {
      allow read: if true;
      // Club records and member progress are canonical in story-data/PostgreSQL.
      // This document remains only as the parent for the temporary Firebase chat.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        // Chat is the temporary Firebase-only portion of book clubs. Membership
        // now lives in PostgreSQL, so this rule can only retain sender identity;
        // membership enforcement returns when chat moves to story-data.
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.content.size() <= 10000;
        allow delete: if request.auth != null &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // Client-side daily/hourly counters. Only two features still use them —
    // book club chat and book search — because everything story-data owns is
    // metered server-side, in the same transaction as the write.
    match /userActivity/{activityId} {
      allow read: if request.auth != null && (
        activityId.matches(request.auth.uid + '_.*') ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow create: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == request.auth.uid;

      // Counts can only increase — prevents resetting to 0 to bypass rate
      // limits — and are bounded to prevent MAX_INT injection.
      allow update: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.get('messageCount', 0)    >= resource.data.get('messageCount', 0) &&
        request.resource.data.get('bookSearchCount', 0) >= resource.data.get('bookSearchCount', 0) &&
        request.resource.data.get('messageCount', 0)    <= 10000 &&
        request.resource.data.get('bookSearchCount', 0) <= 10000;

      allow delete: if false;
    }

    match /users/{userId} {
      // block sensitive fields on create — Cloud Functions set these via Admin SDK, never the client.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        !('hasCustomAiProvider' in request.resource.data) &&
        !('aiSettings' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('isAdmin' in request.resource.data);
      allow read: if request.auth != null && request.auth.uid == userId;

      // Blocks the sensitive BYOK/admin fields (to prevent self-elevating
      // hasCustomAiProvider to bypass AI quotas) and every quota counter. The
      // counters are maintained solely by the Admin SDK — consumeDailyBudget
      // (usageBudget.ts) for the aiUsage/indexUsage pairs — and no client code
      // writes them. Leaving one writable lets a user reset their own ceiling:
      // zeroing indexUsage/lastIndexUsageDate buys unlimited embedding passes.
      //
      // The follow graph is no longer here; it is `user_follows` in
      // story-data, reached through /v1/profiles/{id}/follow.
      allow update: if request.auth != null &&
        userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['hasCustomAiProvider', 'aiSettings', 'role', 'isAdmin',
                   'aiUsage', 'lastAiUsageDate',
                   'indexUsage', 'lastIndexUsageDate', 'storyCount',
                   'faucetUsage', 'lastFaucetDate']);

      // Daily storage upload counters — written only by Cloud Functions (Admin SDK).
      match /_storageQuota/{dayKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // MCP OAuth state (taleTribe-agents MCP server). Written and read ONLY by
    // the agents service via the Admin SDK, which bypasses these rules; token
    // and code documents are keyed by SHA-256 hashes of the credentials.
    // Firestore is default-deny so these blocks change nothing — they exist to
    // document that no client SDK may ever touch these collections.
    match /mcpOauthClients/{clientId} {
      allow read, write: if false;
    }
    match /mcpOauthTxns/{txnId} {
      allow read, write: if false;
    }
    match /mcpOauthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /mcpOauthTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /mcpWrites/{writeKey} {
      allow read, write: if false;
    }

    match /mcpAccess/{uid} {
      function isValidMcpRequest() {
        return request.resource.data.status == 'requested'
               && request.resource.data.keys().hasOnly(['status', 'requestedAt', 'note'])
               && request.resource.data.requestedAt == request.time
               && (!('note' in request.resource.data)
                   || (request.resource.data.note is string
                       && request.resource.data.note.size() <= 500));
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidMcpRequest();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.status == 'revoked'
                    && isValidMcpRequest();
      allow delete: if false;
    }
  }
}
