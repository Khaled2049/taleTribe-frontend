rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function storyIsVisibleTo(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return s.isPublished == true || (request.auth != null && s.userId == request.auth.uid);
    }

    function clubMembers(data) {
      let members = data.get("members", []);
      return members is list ? members : [];
    }

    // Per-user story cap. Reads the denormalized counter maintained by the
    // onStoryWrite Cloud Function; treats a missing user doc / field as 0. Bounds the
    // total embedding/storage cost one account can drive (soft cap — see
    // storyCountTrigger.ts). Keep MAX_STORIES_PER_USER in sync with that doc.
    function userStoryCount(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get("storyCount", 0)
        : 0;
    }

    // True if the requester wrote the parent guestbook entry. Lets an entry
    // author cascade-delete child docs (replies/votes) created by other users —
    // deleteEntry() in GuestbookService relies on this. The guestbook owner
    // needs no equivalent: ownerId is a path segment, so their check is free.
    function isEntryAuthor(ownerId, entryId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(ownerId)/guestbook/$(entryId))
        && get(/databases/$(database)/documents/users/$(ownerId)/guestbook/$(entryId)).data.authorId == request.auth.uid;
    }

    // Vote counters may move by at most one in each direction and never below
    // zero. NOTE: this bounds the size of a forged bump but does not require a
    // matching votes/{uid} document — a determined client can still inflate a
    // count by repeating the write. Nothing ranks by these numbers, so the
    // exposure is a wrong display, not a wrong ordering.
    function voteCountersBounded() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount'])
        && request.resource.data.upvoteCount >= 0
        && request.resource.data.downvoteCount >= 0
        && request.resource.data.upvoteCount >= resource.data.upvoteCount - 1
        && request.resource.data.upvoteCount <= resource.data.upvoteCount + 1
        && request.resource.data.downvoteCount >= resource.data.downvoteCount - 1
        && request.resource.data.downvoteCount <= resource.data.downvoteCount + 1;
    }

    // Who may sign a wall. The policy lives on publicProfiles because the client
    // must read it to decide whether to render a compose form, and cannot read
    // the owner's user doc. Every access is exists()-guarded: get() on a missing
    // document returns null, and dereferencing .data on null errors — which
    // denies rather than falling through to the default.
    //
    // A missing profile, a missing field, and a missing user doc all read as
    // 'everyone'. That is what makes this setting additive: no migration, and no
    // behaviour change for an account that never touches it.
    function guestbookPolicyOf(ownerId) {
      return exists(/databases/$(database)/documents/publicProfiles/$(ownerId))
        ? get(/databases/$(database)/documents/publicProfiles/$(ownerId)).data.get('guestbookPolicy', 'everyone')
        : 'everyone';
    }

    // The follow graph is stored on both sides, so both directions come off the
    // owner's single document.
    function wallRelationAllows(ownerId, policy) {
      let owner = get(/databases/$(database)/documents/users/$(ownerId)).data;
      let uid = request.auth.uid;
      let isFollower = owner.get('followers', []).hasAny([uid]);
      let isFollowed = owner.get('following', []).hasAny([uid]);
      return (policy == 'followers' && isFollower)
        || (policy == 'following' && isFollowed)
        || (policy == 'mutuals' && isFollower && isFollowed);
    }

    // Gates entries and replies alike. The owner is never locked out of their
    // own page, whatever the setting says. KEEP IN SYNC with canPostOnWall() in
    // src/lib/guestbookPolicy.ts, which decides whether the form is shown.
    function mayPostOnWall(ownerId) {
      let policy = guestbookPolicyOf(ownerId);
      return request.auth != null && (
        request.auth.uid == ownerId
        || policy == 'everyone'
        || (policy != 'nobody'
            && exists(/databases/$(database)/documents/users/$(ownerId))
            && wallRelationAllows(ownerId, policy))
      );
    }

    // Invites collection for invite-only signup
    match /invites/{email} {
      // enforce linkSentCount == 0 on create — prevent injecting a pre-incremented counter.
      allow create: if request.auth == null
                    && request.resource.data.email == email
                    && request.resource.data.status == "pending"
                    && request.resource.data.linkSentCount == 0
                    && request.resource.data.keys().hasAll(["email", "status", "requestedAt", "linkSentCount"]);

      // Unauthenticated get is intentional — allows invite status check before login.
      // list=false prevents email enumeration via collection scans.
      allow get: if request.auth == null ||
                   (request.auth != null && request.auth.token.email == email);
      allow list: if false;

      // scope update to status field only — other fields immutable after create.
      allow update: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email == email
                    && request.resource.data.status == "completed"
                    && (resource.data.status == "sent" || resource.data.status == "approved")
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.content.size() <= 10000;
      allow update, delete: if request.auth != null && resource.data.creator == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.content.size() <= 10000;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /plotTemplates/{templateId} {
      allow read: if true;
      // enforce userId on create so ownership is consistent with update/delete.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if resource.data.isPublished == true
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && userStoryCount(request.auth.uid) < 100; // MAX_STORIES_PER_USER

      allow update: if (
        // Unauthenticated view increment: exactly +1 only.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1
      ) ||
      (request.auth != null && (
        // likes delta bounded to ±1, non-negative — prevents arbitrary counter injection.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         request.resource.data.likes >= 0 &&
         (request.resource.data.likes == resource.data.likes + 1 ||
          request.resource.data.likes == resource.data.likes - 1)) ||
        // averageRating bounded to valid 1–5 range.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating']) &&
         request.resource.data.averageRating >= 1 &&
         request.resource.data.averageRating <= 5) ||
        // ratingsCount increment-only (ratings are permanent).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingsCount']) &&
         request.resource.data.ratingsCount >= 0 &&
         request.resource.data.ratingsCount == resource.data.ratingsCount + 1) ||
        // combined averageRating+ratingsCount — both constraints must hold.
        (request.resource.data.diff(resource.data).affectedKeys().hasAll(['averageRating', 'ratingsCount']) &&
         request.resource.data.diff(resource.data).affectedKeys().size() == 2 &&
         request.resource.data.averageRating >= 1 &&
         request.resource.data.averageRating <= 5 &&
         request.resource.data.ratingsCount >= 0 &&
         request.resource.data.ratingsCount == resource.data.ratingsCount + 1) ||
        resource.data.userId == request.auth.uid
      ));

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          likeId == request.auth.uid;
        allow delete: if request.auth != null && likeId == request.auth.uid;
      }

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          ratingId == request.auth.uid &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5;
      }

      match /chapters/{chapterId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid &&
          (!('content' in request.resource.data) || request.resource.data.content.size() <= 100000);
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid &&
          (!('content' in request.resource.data) || request.resource.data.content.size() <= 100000);
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null &&
            request.resource.data.userId == request.auth.uid;
          allow update: if request.auth != null &&
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt']);
          allow delete: if request.auth != null &&
            resource.data.userId == request.auth.uid;

          match /likes/{likeId} {
            allow read: if true;
            // constrain likeId == auth.uid — prevents multiple likes per user on same comment.
            allow create: if request.auth != null &&
              likeId == request.auth.uid &&
              request.resource.data.userId == request.auth.uid;
            allow delete: if request.auth != null &&
              likeId == request.auth.uid;
          }
        }
      }

      match /plots/{plotId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /characters/{characterId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /places/{placeId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /chats/{chatId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null &&
            request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId;
        }
      }
    }


    // Async generation jobs (chapter/story/brainstorm). Created and updated
    // ONLY by Cloud Functions via the Admin SDK. Owners may read their own job
    // to observe progress/completion in realtime (replaces HTTP polling). The
    // owner uid is denormalized onto the job doc so this is a cheap field
    // compare — no cross-doc story lookup.
    match /jobs/{jobId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookClubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.members is list;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
      // members update — non-creators may only add/remove themselves (mirrors follower logic).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && (
          // Join: add yourself only
          (clubMembers(request.resource.data).size() == clubMembers(resource.data).size() + 1 &&
           clubMembers(request.resource.data).hasAll(clubMembers(resource.data)) &&
           !clubMembers(resource.data).hasAny([request.auth.uid])) ||
          // Leave: remove yourself only
          (clubMembers(request.resource.data).size() == clubMembers(resource.data).size() - 1 &&
           clubMembers(resource.data).hasAll(clubMembers(request.resource.data)) &&
           clubMembers(resource.data).hasAny([request.auth.uid]))
        )) ||
        // discussionPrompts / polls — members may reply to a thread or cast a
        // vote, both of which rewrite the whole array (client does read+map+write).
        // New threads/polls are creator-only (gated in the UI), so member writes
        // must not change the top-level list length. Rules can't cheaply verify
        // "only my own nested entry changed", so a member could in principle
        // clobber another member's response/vote in the same write — same trust
        // level as the /messages subcollection's membership check.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discussionPrompts']) &&
         clubMembers(resource.data).hasAny([request.auth.uid]) &&
         request.resource.data.discussionPrompts.size() == resource.data.discussionPrompts.size()) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['polls']) &&
         clubMembers(resource.data).hasAny([request.auth.uid]) &&
         request.resource.data.polls.size() == resource.data.polls.size())
      );

      match /messages/{messageId} {
        allow read: if true;
        // require membership or creator status — prevents non-members from posting.
        // senderId must match the caller — prevents impersonating another user.
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.content.size() <= 10000 && (
          get(/databases/$(database)/documents/bookClubs/$(clubId)).data.creatorId == request.auth.uid ||
          clubMembers(get(/databases/$(database)/documents/bookClubs/$(clubId)).data).hasAny([request.auth.uid])
        );
        allow delete: if request.auth != null &&
          resource.data.senderId == request.auth.uid;
      }

      match /memberProgress/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null &&
          userId == request.auth.uid &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null &&
          userId == request.auth.uid;
      }
    }

    // Competitions are read-only to every client. Creating one debits the
    // creator's TALE into escrow, and updating one changes the terms people
    // entered under, so all mutation runs in Cloud Functions via the Admin SDK
    // (competitionEndpoints.ts: createCompetition / updateCompetition /
    // cancelCompetition / joinCompetition).
    //
    // The previous rules allowed create for ANY authenticated user who set
    // creatorId to their own uid — the admin gate was only a `disabled`
    // attribute on a button — and allowed the creator to rewrite every field,
    // including participantsCount, which joinCompetition maintains in a
    // transaction. With a real prize pool attached, that would have meant any
    // user writing themselves a funded competition and editing their own
    // prize.
    //
    // Deletion is gone entirely: a competition holding escrow cannot be
    // removed, only cancelled and refunded.
    // Drafts are private to their creator. `published` is denormalized from the
    // phase specifically so this rule and the explore query can both match on a
    // field — an inequality on `phase` would force the query's first orderBy
    // onto `phase` and destroy the createdAt sort.
    //
    // Any client listing this collection must constrain on `published` or on
    // `creatorId`; an unconstrained list is rejected outright, which is the
    // intended behaviour and is covered by the rules tests.
    match /competitions/{competitionId} {
      // `.get(field, default)` rather than `.published`: reading a property that
      // is absent is an ERROR in rules, not false, so a document written before
      // this field existed would be unreadable rather than merely unlisted.
      // Defaulting to false fails closed: an unflagged document stays private
      // to its creator instead of leaking.
      allow read: if resource.data.get('published', false) == true
                  || (request.auth != null
                      && request.auth.uid == resource.data.get('creatorId', ''));
      allow write: if false;

      match /participants/{userId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }

      // What each entrant paid, and whether it is still held.
      //
      // `list` MUST stay false. Unlike `participants`, these carry amounts, so
      // an enumerable collection would hand any signed-in client the roster of
      // who paid what. A reader only ever needs their own.
      match /contributions/{userId} {
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if false;
        allow write: if false;
      }

      // Entries are a public gallery — they link to stories that are already
      // published, so there is nothing here that isn't public anyway. Written
      // only by submitToCompetition / withdrawSubmission, which enforce story
      // ownership, the published requirement, and the entry deadline.
      match /submissions/{userId} {
        allow read: if true;
        allow write: if false;
      }

      // A ballot is readable only by the voter who cast it, so the UI can show
      // "you backed these three".
      //
      // `list` MUST stay false. A client able to list this subcollection could
      // read every ballot and reconstruct the exact standings that the voting
      // phase exists to hide — without ever reading a document it isn't
      // entitled to. Denying `get` alone would not be enough.
      match /votes/{voterId} {
        allow get: if request.auth != null && request.auth.uid == voterId;
        allow list: if false;
        allow write: if false;
      }

      // Running vote tallies. Denied to every client, which is what makes
      // "results are hidden until settlement" a property of the database rather
      // than of the UI. Settlement reads this single document instead of every
      // submission, which is also what keeps that transaction bounded.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    match /userActivity/{activityId} {
      allow read: if request.auth != null && (
        activityId.matches(request.auth.uid + '_.*') ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow create: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == request.auth.uid;

      // Counts can only increase — prevents resetting to 0 to bypass rate limits.
      // added upper bounds (10 000) to prevent MAX_INT injection.
      allow update: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.get('postCount', 0)            >= resource.data.get('postCount', 0) &&
        request.resource.data.get('commentCount', 0)         >= resource.data.get('commentCount', 0) &&
        request.resource.data.get('messageCount', 0)         >= resource.data.get('messageCount', 0) &&
        request.resource.data.get('bookSearchCount', 0)      >= resource.data.get('bookSearchCount', 0) &&
        request.resource.data.get('pollCount', 0)            >= resource.data.get('pollCount', 0) &&
        request.resource.data.get('voteChangeCount', 0)      >= resource.data.get('voteChangeCount', 0) &&
        request.resource.data.get('promptCount', 0)          >= resource.data.get('promptCount', 0) &&
        request.resource.data.get('promptResponseCount', 0)  >= resource.data.get('promptResponseCount', 0) &&
        request.resource.data.get('progressUpdateCount', 0)  >= resource.data.get('progressUpdateCount', 0) &&
        request.resource.data.get('postCount', 0)            <= 10000 &&
        request.resource.data.get('commentCount', 0)         <= 10000 &&
        request.resource.data.get('messageCount', 0)         <= 10000 &&
        request.resource.data.get('bookSearchCount', 0)      <= 10000 &&
        request.resource.data.get('pollCount', 0)            <= 10000 &&
        request.resource.data.get('voteChangeCount', 0)      <= 10000 &&
        request.resource.data.get('promptCount', 0)          <= 10000 &&
        request.resource.data.get('promptResponseCount', 0)  <= 10000 &&
        request.resource.data.get('progressUpdateCount', 0)  <= 10000;

      allow delete: if false;
    }

    // private lists were readable by all authenticated users — now owner-only when not public.
    match /bookLists/{listId} {
      allow read: if resource.data.isPublic == true ||
                   (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                      resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
                       resource.data.userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      function ownerWritableKeys() {
        return ["username", "usernameLower", "photoURL", "updatedAt", "bio",
                "occupation", "location", "createdAt", "guestbookPolicy"];
      }

      function validProfile() {
        return request.resource.data.username is string &&
          request.resource.data.updatedAt is string &&
          // Derived by PublicProfileService.upsertPublicProfile, never typed by
          // a user: the search key must not diverge from the display name.
          request.resource.data.usernameLower == request.resource.data.username.lower() &&
          (!("photoURL" in request.resource.data) || request.resource.data.photoURL is string) &&
          (!("bio" in request.resource.data) || request.resource.data.bio is string) &&
          (!("occupation" in request.resource.data) || request.resource.data.occupation is string) &&
          (!("location" in request.resource.data) || request.resource.data.location is string) &&
          (!("createdAt" in request.resource.data) || request.resource.data.createdAt is string) &&
          (!("guestbookPolicy" in request.resource.data) ||
            request.resource.data.guestbookPolicy in ['nobody', 'following', 'mutuals', 'followers', 'everyone']);
      }

      allow get: if request.auth != null;

      // The people directory. This is the only listable collection carrying
      // usernames, and opening it makes bio/occupation/location enumerable by
      // any signed-in member — the accepted price of prefix search without a
      // paid index. The limit bounds one request's cost; it does not stop a
      // client paging the whole directory, and is not meant to.
      allow list: if request.auth != null && request.query.limit <= 30;

      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(ownerWritableKeys()) &&
        request.resource.data.keys().hasAll(["username", "usernameLower", "updatedAt"]) &&
        validProfile();

      // affectedKeys(), not keys(): every write here is a merge, so keys()
      // describes the whole resulting document. Any field the client does not
      // own — the stray displayName an old backfill wrote — would otherwise
      // lock the owner out of their own profile permanently.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerWritableKeys()) &&
        validProfile();

      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        username == username.lower() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{userId} {
      // block sensitive fields on create — Cloud Functions set these via Admin SDK, never the client.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        !('hasCustomAiProvider' in request.resource.data) &&
        !('aiSettings' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('isAdmin' in request.resource.data);
      allow read: if request.auth != null && request.auth.uid == userId;

      // own-profile branch also blocks sensitive BYOK/admin fields (to prevent
      // self-elevating hasCustomAiProvider to bypass AI quotas) and every quota
      // counter. The counters are maintained solely by the Admin SDK —
      // consumeDailyBudget (usageBudget.ts) for the aiUsage/indexUsage/faucetUsage
      // pairs and onStoryWrite (storyCountTrigger.ts) for storyCount — and no
      // client code writes them. Leaving one writable lets a user reset their own
      // ceiling: zeroing indexUsage/lastIndexUsageDate buys unlimited embedding
      // passes, zeroing storyCount defeats the per-user story cap in
      // userStoryCount(), and zeroing faucetUsage/lastFaucetDate mints unlimited
      // TALE from the once-a-day faucet.
      allow update: if request.auth != null && (
        (userId == request.auth.uid &&
         request.resource.data.followers == resource.data.followers &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['hasCustomAiProvider', 'aiSettings', 'role', 'isAdmin',
                    'aiUsage', 'lastAiUsageDate',
                    'indexUsage', 'lastIndexUsageDate', 'storyCount',
                    'faucetUsage', 'lastFaucetDate'])) ||
        // Follow/unfollow: only the followers field may change
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) && (
          // Follow: add yourself
          (request.resource.data.followers.size() == resource.data.followers.size() + 1 &&
           request.resource.data.followers.hasAll(resource.data.followers) &&
           !resource.data.followers.hasAny([request.auth.uid])) ||
          // Unfollow: remove yourself
          (request.resource.data.followers.size() == resource.data.followers.size() - 1 &&
           resource.data.followers.hasAll(request.resource.data.followers) &&
           resource.data.followers.hasAny([request.auth.uid]))
        ))
      );

      // Daily storage upload counters — written only by Cloud Functions (Admin SDK).
      match /_storageQuota/{dayKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /competitionJoins/{competitionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // Reading history is private. `allow read` grants list as well as get, so
      // opening it would let any signed-in user enumerate another user's whole
      // reading history. If public reading history is ever built, scope the
      // relaxation to get and read specific docs rather than listing.
      match /readingProgress/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // A public wall on a private parent. `allow read` here is independent of
      // users/{userId} above, which stays owner-only — subcollection rules do
      // not inherit. Anyone may page through anyone's guestbook.
      match /guestbook/{entryId} {
        allow read: if true;

        // Whoever the owner's policy admits may sign, but only as themselves,
        // and only with counters starting at zero.
        allow create: if request.auth != null
          && mayPostOnWall(userId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.ownerId == userId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 10000
          && request.resource.data.upvoteCount == 0
          && request.resource.data.downvoteCount == 0
          && request.resource.data.commentCount == 0;

        allow update: if request.auth != null && (
          // Author edits their own text. ownerId/authorId/createdAt are
          // immutable because they are absent from the allowed key set.
          (resource.data.authorId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])) ||
          // Reply counter. Rises one at a time, but may fall by more than one:
          // deleting a reply takes its whole nested subtree with it.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
           request.resource.data.commentCount >= 0 &&
           request.resource.data.commentCount <= resource.data.commentCount + 1) ||
          voteCountersBounded()
        );

        // The entry's author anywhere, or the owner of this guestbook. The
        // owner branch is what replaces a report flow: you can always clear
        // your own page.
        allow delete: if request.auth != null &&
          (resource.data.authorId == request.auth.uid || request.auth.uid == userId);

        match /votes/{voterId} {
          allow read: if true;
          allow create, update: if request.auth != null
            && voterId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.voteType in ['up', 'down'];
          allow delete: if request.auth != null && (
            voterId == request.auth.uid ||
            request.auth.uid == userId ||
            isEntryAuthor(userId, entryId)
          );
        }

        match /replies/{replyId} {
          allow read: if true;

          // Same gate as the entry: a closed wall must not stay talkable in its
          // threads. The commentCount bump on the parent needs no gate of its
          // own — this create fails first, since addReply() writes the reply
          // before incrementing.
          allow create: if request.auth != null
            && mayPostOnWall(userId)
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 10000
            && request.resource.data.upvoteCount == 0
            && request.resource.data.downvoteCount == 0;

          allow update: if request.auth != null && (
            (resource.data.authorId == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt'])) ||
            voteCountersBounded()
          );

          // Reply author, guestbook owner, or the entry's author.
          allow delete: if request.auth != null && (
            resource.data.authorId == request.auth.uid ||
            request.auth.uid == userId ||
            isEntryAuthor(userId, entryId)
          );

          match /votes/{voterId} {
            allow read: if true;
            allow create, update: if request.auth != null
              && voterId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.voteType in ['up', 'down'];
            allow delete: if request.auth != null && (
              voterId == request.auth.uid ||
              request.auth.uid == userId ||
              isEntryAuthor(userId, entryId)
            );
          }
        }
      }
    }

    // MCP OAuth state (taleTribe-agents MCP server). Written and read ONLY by
    // the agents service via the Admin SDK, which bypasses these rules; token
    // and code documents are keyed by SHA-256 hashes of the credentials.
    // Firestore is default-deny so these blocks change nothing — they exist to
    // document that no client SDK may ever touch these collections.
    match /mcpOauthClients/{clientId} {
      allow read, write: if false;
    }
    match /mcpOauthTxns/{txnId} {
      allow read, write: if false;
    }
    match /mcpOauthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /mcpOauthTokens/{tokenHash} {
      allow read, write: if false;
    }
    
    match /mcpWrites/{writeKey} {
      allow read, write: if false;
    }

    match /mcpAccess/{uid} {
      function isValidMcpRequest() {
        return request.resource.data.status == 'requested'
               && request.resource.data.keys().hasOnly(['status', 'requestedAt', 'note'])
               && request.resource.data.requestedAt == request.time
               && (!('note' in request.resource.data)
                   || (request.resource.data.note is string
                       && request.resource.data.note.size() <= 500));
      }
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && isValidMcpRequest();
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.status == 'revoked'
                    && isValidMcpRequest();
      allow delete: if false;
    }

    // ---- Platform token (TALE) ----------------------------------------------
    // TALE backs competition prize pools. Balances are maintained exclusively by
    // the Admin SDK (functions/src/ledger.ts) inside transactions that write the
    // transfer and both balances together.

    // Materialized balances — a projection of ledgerTransfers, rebuildable by
    // replaying it. Self-read is allowed so the UI can show a live balance via
    // onSnapshot. `list` stays false so balances are not enumerable across users,
    // and no client may write: a writable balance is a mint.
    match /tokenAccounts/{accountId} {
      allow get: if request.auth != null
                 && resource.data.ownerId == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // The double-entry transfer log — the source of truth every balance derives
    // from. Denied to clients entirely: postings name both counterparties, so an
    // `accountIds array-contains` read would expose who paid whom. Transaction
    // history ships later as an endpoint that filters server-side.
    match /ledgerTransfers/{transferId} {
      allow read, write: if false;
    }
  }
}
