{
  "name": "the-tale-tribe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "kill-ports": "test -x ../../kill-ports && ../../kill-ports || echo 'kill-ports moved to TheTaleTribe workspace root (it now stops story-data and creditProxy too). Run ./kill-ports from there.'",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint src packages --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "start:agent": "cd python && python server.py",
    "start:emulator": "npm run emulator --prefix functions",
    "start:export": "npm run export-prod --prefix functions",
    "start:vite": "yarn dev",
    "cy:open": "cypress open",
    "cy:run": "cypress run --e2e",
    "e2e": "./scripts/e2e-stack.sh",
    "test": "vitest run",
    "assistant:contracts:generate": "yarn workspace @novelsync/assistant-contracts run generate",
    "assistant:contracts:check": "yarn workspace @novelsync/assistant-contracts run check",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.21",
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.13",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-dropcursor": "^3.31.3",
    "@tiptap/extension-gapcursor": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list-item": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "aos": "^2.3.4",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "framer-motion": "^11.5.4",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.446.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.2.1",
    "react-intersection-observer": "^9.13.0",
    "react-markdown": "^10.1.0",
    "react-modal": "^3.16.1",
    "react-responsive-carousel": "^3.2.23",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "unique-names-generator": "^4.7.1",
    "uuid": "^14.0.2",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/aos": "^3.0.7",
    "@types/node": "^22.19.5",
    "@types/react": "^19.3.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "cypress": "^14.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "react-router-dom": "^7.18.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "protobufjs": "^7.5.5",
    "undici": "^6.27.0",
    "qs": "^6.15.2",
    "uuid": "^14.0.2",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  }
}
