{
  "name": "novel-sync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "kill-ports": "./kill-ports-for-emulator",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start:agent": "cd python && python server.py",
    "start:emulator": "npm run emulator --prefix functions",
    "start:export": "npm run export-prod --prefix functions",
    "start:vite": "yarn dev",
    "cy:open": "cypress open",
    "cy:run": "cypress run --e2e",
    "e2e": "./scripts/e2e-stack.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.ts"
  },
