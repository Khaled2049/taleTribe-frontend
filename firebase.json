{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://books.google.com https://*.googleapis.com https://*.gstatic.com https://*.appspot.com https://picsum.photos https://fastly.picsum.photos; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://*.run.app https://rpc.sepolia.org https://ethereum-rpc.publicnode.com https://*.g.alchemy.com https://api.dictionaryapi.dev https://relay.walletconnect.com wss://relay.walletconnect.com https://*.walletconnect.com https://huggingface.co https://*.huggingface.co https://*.hf.co; frame-src https://*.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hosting": {
      "port": 5033,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true
    },
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1",
      "rules": "firestore.rules"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "database": {
      "port": 9000,
      "host": "127.0.0.1"
    },
    "pubsub": {
      "port": 8085,
      "host": "127.0.0.1"
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "novelsync/**",
        "__pycache__/**",
        "*.py",
        "*.pyc",
        "requirements.txt",
        "Dockerfile",
        "cloudbuild.yaml",
        ".dockerignore",
        "start-local.*",
        "*.md",
        "readme.md",
        "LOCAL_DEVELOPMENT.md",
        "API_DOCUMENTATION.md"
      ]
    }
  ]
}
