# Application Configuration
VITE_APP_NAME=thetaletribe

# Firebase Configuration (Frontend - Public)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=thetaletribe.com
VITE_FIREBASE_PROJECT_ID=story-6f89f
VITE_FIREBASE_STORAGE_BUCKET=story-6f89f.appspot.com
VITE_FIREBASE_MESSAGE_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Web3 Configuration
# Active chain selection (31337=anvil, 11155111=sepolia, 1=mainnet)
VITE_CHAIN_ID=31337

# Optional shared fallback RPC for all chains
VITE_RPC_URL=

# Per-chain RPC URLs (recommended)
VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional fallback addresses (used if per-chain keys are not set)
VITE_USDC_TOKEN_ADDRESS=0x...
VITE_TIPPING_CONTRACT_ADDRESS=0x...

# Per-chain token/contract addresses (recommended)
VITE_USDC_TOKEN_ADDRESS_ANVIL=0x...
VITE_USDC_TOKEN_ADDRESS_SEPOLIA=0x...
VITE_USDC_TOKEN_ADDRESS_MAINNET=0x...
VITE_TIPPING_CONTRACT_ADDRESS_ANVIL=0x...
VITE_TIPPING_CONTRACT_ADDRESS_SEPOLIA=0x...
VITE_TIPPING_CONTRACT_ADDRESS_MAINNET=0x...
VITE_MAX_AI_USAGE=100

# AI story discovery. Set false to hide recommendation entry points while the
# recommendation Cloud Run service or its scheduled catalog sync is unavailable.
VITE_RECOMMENDATIONS_ENABLED=true

# Firebase Functions -> private recommendation Cloud Run service. This is a
# server-side value, never expose it as VITE_RECOMMENDATION_SERVICE_URL.
RECOMMENDATION_SERVICE_URL=http://localhost:8100

# MCP server (agents service base URL for the /mcp-connect consent page)
VITE_AGENT_MCP_URL=http://localhost:8000

# Python Agent Configuration (Backend - Secret)
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key
